---
/**
 * The home page: PRERENDERED (built once, served as a static file). Words in
 * `src/content/site.ts`.
 *
 * The latest episode changes when the owner adds one in /portal/episodes, so
 * the browser fills it in after load from `GET /site-api/episodes` (built with
 * `textContent` only). Until then the frame shows a skeleton; if the list
 * cannot be read, the frame shows a photo and a link to all episodes.
 */
import Icon from '../components/Icon.astro';
import {HOME, PHOTOS, SHOW, TOPIC_COPY} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic description={`${SHOW.name}: ${SHOW.tagline}`}>
  <main>
    <section class="home-hero">
      <div class="wrap home-hero-inner">
        <div class="home-hero-text">
          <p class="eyebrow">{HOME.hero.eyebrow}</p>
          <h1 class="hero-title">{HOME.hero.title}</h1>
          <p class="lead">{HOME.hero.body}</p>
          <div class="actions" data-guest-only>
            <a class="button lg" href="/join">{HOME.hero.cta}</a>
          </div>
          <div class="actions" data-member-only hidden>
            <a class="button lg" href="/feeds">Open the community</a>
          </div>
          <p class="hero-note">
            New here? <a href="/episodes">Watch the episodes</a> or <a href="/ask">ask Mark &amp; Hank a question</a>.
          </p>
        </div>

        <div class="home-hero-media" data-latest>
          <div class="frame ratio-video video-frame" data-latest-frame aria-busy="true">
            <div class="skeleton skeleton-fill"></div>
          </div>
          <div class="media-caption" data-latest-caption>
            <span class="skeleton-line" style="width: 60%" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-alt" aria-labelledby="show-title">
      <div class="wrap">
        <div class="split">
          <div class="stack">
            <p class="eyebrow">{HOME.intro.eyebrow}</p>
            <h2 class="h-section" id="show-title">{HOME.intro.title}</h2>
            {HOME.intro.paragraphs.map(p => <p class="body-copy">{p}</p>)}
            <div class="actions">
              <a class="button ghost" href="/about">Meet Mark and Hank</a>
            </div>
          </div>
          <div class="frame ratio-photo">
            <img
              src={PHOTOS.training}
              alt="A sales trainer talking with a small group of salespeople in a bright office"
              loading="lazy"
              width="1600"
              height="1200"
            />
          </div>
        </div>
        <div class="rule-cols">
          {
            HOME.intro.pillars.map(pillar => (
              <div>
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="audience-title">
      <div class="wrap">
        <div class="stack">
          <p class="eyebrow">{HOME.audience.eyebrow}</p>
          <h2 class="h-section" id="audience-title">{HOME.audience.title}</h2>
        </div>
        <div class="rule-cols">
          {
            HOME.audience.items.map(item => (
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band band-alt" aria-labelledby="topics-title">
      <div class="wrap split top">
        <div class="stack">
          <p class="eyebrow">{HOME.topics.eyebrow}</p>
          <h2 class="h-section" id="topics-title">{HOME.topics.title}</h2>
          <div class="actions">
            <a class="button ghost" href="/topics">See every topic</a>
          </div>
        </div>
        <ul class="topic-list">
          {
            TOPIC_COPY.map((topic, i) => (
              <li>
                <a class="topic-link" href={`/topics#${topic.slug}`}>
                  <span class="topic-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="topic-name">{topic.title}</span>
                  <Icon name="arrow-right" class="topic-arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="band" aria-labelledby="more-title" data-more hidden>
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="eyebrow">Recent episodes</p>
            <h2 class="h-md" id="more-title">Catch up on what you missed.</h2>
          </div>
          <a class="more" href="/episodes">All episodes →</a>
        </div>
        <ul class="episode-grid" data-more-list></ul>
      </div>
    </section>

    <section class="band band-wash" aria-labelledby="community-title">
      <div class="wrap split">
        <div class="stack">
          <p class="eyebrow">{HOME.community.eyebrow}</p>
          <h2 class="h-section" id="community-title">{HOME.community.title}</h2>
          <p class="lead">{HOME.community.body}</p>
          <div class="actions" data-guest-only>
            <a class="button lg" href="/join">{HOME.hero.cta}</a>
            <a class="button lg ghost" href="/login?redirectTo=%2F">Log in</a>
          </div>
          <div class="actions" data-member-only hidden>
            <a class="button lg" href="/feeds">Open the community</a>
          </div>
        </div>
        <ul class="fact-list fact-list-lg">
          {
            HOME.community.points.map(point => (
              <li>
                <Icon name="check" />
                {point}
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>

<script>
  import {EPISODE_FALLBACK_PHOTO, PHOTOS} from '../content/site';
  import {formatDate} from '../lib/format';
  import {type EpisodeSummary, type EpisodesPage, topicLabel} from '../lib/types';

  /** One element with text: never HTML from an answer. */
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  const PLAY =
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L7.5 3.64A1 1 0 0 0 6 4.5Z" fill="currentColor"/></svg>';

  const thumbOf = (episode: EpisodeSummary) =>
    episode.youtubeId
      ? `https://i.ytimg.com/vi/${encodeURIComponent(episode.youtubeId)}/hqdefault.jpg`
      : EPISODE_FALLBACK_PHOTO;
  const href = (episode: EpisodeSummary) => `/episodes/${encodeURIComponent(episode.slug)}`;

  const frame = document.querySelector<HTMLElement>('[data-latest-frame]')!;
  const caption = document.querySelector<HTMLElement>('[data-latest-caption]')!;

  /** The latest episode: a click-to-play YouTube player (nothing loads from YouTube until then). */
  function showLatest(episode: EpisodeSummary) {
    frame.replaceChildren();
    const img = el('img');
    img.src = episode.youtubeId
      ? `https://i.ytimg.com/vi/${encodeURIComponent(episode.youtubeId)}/maxresdefault.jpg`
      : EPISODE_FALLBACK_PHOTO;
    img.alt = '';
    img.width = 1280;
    img.height = 720;
    if (episode.youtubeId) img.onerror = () => (img.src = thumbOf(episode));
    frame.append(img);

    if (episode.youtubeId) {
      const play = el('button', 'play-badge');
      play.type = 'button';
      play.setAttribute('aria-label', `Play episode: ${episode.title}`);
      play.innerHTML = PLAY; // our own constant, not data
      play.addEventListener('click', () => {
        const iframe = el('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(episode.youtubeId!)}?autoplay=1&rel=0`;
        iframe.title = episode.title;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        frame.replaceChildren(iframe);
        iframe.focus();
      });
      frame.append(el('span', 'badge overlay', 'Latest episode'), play);
    } else {
      const pending = el('a', 'video-pending', 'Video coming soon: read the episode notes');
      (pending as HTMLAnchorElement).href = href(episode);
      frame.append(el('span', 'badge overlay', 'Latest episode'), pending);
    }
    frame.removeAttribute('aria-busy');

    caption.replaceChildren();
    const title = el('a', '', episode.title);
    (title as HTMLAnchorElement).href = href(episode);
    const meta = [episode.number ? `Ep. ${episode.number}` : '', formatDate(episode.publishedAt), episode.durationMinutes ? `${episode.durationMinutes} min` : '']
      .filter(Boolean)
      .join(' · ');
    caption.append(title, el('span', 'muted small', meta));
  }

  /** No episode list: a photo and a way to the episodes page, never an empty frame. */
  function showFallback() {
    frame.replaceChildren();
    const img = el('img');
    img.src = PHOTOS.handshake;
    img.alt = 'A salesperson and a customer shaking hands across a desk';
    frame.append(img);
    frame.removeAttribute('aria-busy');
    caption.replaceChildren();
    const link = el('a', '', 'Watch the latest episodes →');
    (link as HTMLAnchorElement).href = '/episodes';
    caption.append(link);
  }

  function card(episode: EpisodeSummary) {
    const a = el('a', 'episode-card');
    a.href = href(episode);
    const thumb = el('div', 'thumb');
    const img = el('img');
    img.src = thumbOf(episode);
    img.alt = '';
    img.loading = 'lazy';
    thumb.append(img);
    if (episode.number) thumb.append(el('span', 'badge overlay', `Ep. ${episode.number}`));
    if (!episode.youtubeId) thumb.append(el('span', 'video-pending', 'Video coming soon'));
    const meta = el('p', 'episode-meta');
    meta.append(el('span', 'badge', topicLabel(episode.topic)), el('span', '', formatDate(episode.publishedAt)));
    a.append(thumb, meta, el('h3', '', episode.title), el('p', '', episode.summary));
    const li = el('li');
    li.append(a);
    return li;
  }

  (async () => {
    try {
      const res = await fetch('/site-api/episodes?perPage=4', {headers: {accept: 'application/json'}});
      if (!res.ok) throw new Error(String(res.status));
      const {episodes} = (await res.json()) as EpisodesPage;
      if (!episodes.length) return showFallback();
      showLatest(episodes[0]);
      const rest = episodes.slice(1);
      if (rest.length) {
        document.querySelector('[data-more-list]')!.append(...rest.map(card));
        document.querySelector<HTMLElement>('[data-more]')!.hidden = false;
      }
    } catch {
      showFallback();
    }
  })();
</script>
