---
/**
 * Header, footer and <head> for every page. The page fetches the brand (`site`)
 * and the visitor (`viewer`) with `pageContext` and passes them in, so the
 * layout never makes an API call of its own.
 *
 * Sign in, sign up, joining and the community itself are App pages on this
 * same hostname: always plain `<a href>`, never a client-side route.
 */
import '../styles/global.css';

import Icon from '../components/Icon.astro';
import {NAV, SHOW} from '../content/site';
import type {Site, Viewer} from '../lib/types';
import {initials} from '../lib/format';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The page's own name; the tab shows "<title> · <community>". Omit on home. */
  title?: string;
  description?: string;
  /** Extra <head> tags, e.g. og:image on a post. */
  image?: string | null;
  /**
   * A PRERENDERED page (`export const prerender = true`): built once, served
   * as a static file, so it knows no visitor. The header then renders the
   * signed-out view and the browser fills in the visitor (`/site-api/me`) and
   * a renamed community (`/site-api/site`) after load.
   */
  isStatic?: boolean;
}

const {site, viewer, title, description, image, isStatic = false} = Astro.props;
const name = site?.name ?? SHOW.community;
const fullTitle = title ? `${title} · ${name}` : name;
const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
// Back to this page after signing in. A PATH only: the App ignores full URLs.
const back = encodeURIComponent(`${path}${Astro.url.search}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title ?? name} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content={name} />
    {site?.favIcon && <link rel="icon" href={site.favIcon} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body data-viewer={viewer.state} data-static={isStatic ? '1' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="wrap site-header-inner">
        <a href="/" class="brand" aria-label={`${name}, home`}>
          {site?.logo && <img class="brand-logo" src={site.logo} alt="" height="32" style="height: 32px" />}
          <span class="brand-name" data-brand-text="{name}" data-built-name={name}>{name}</span><span
            class="brand-dot"
            aria-hidden="true"></span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
          data-nav-toggle>
          <Icon name="menu" />
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          {NAV.map(item => (
            <a href={item.href} class:list={{active: active(item.href)}} aria-current={active(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a
            href="/portal"
            class:list={{active: active('/portal')}}
            data-member-only
            hidden={viewer.state !== 'member'}>
            Dashboard
          </a>
        </nav>
        <div class="session" data-session>
          {viewer.state === 'member' ? (
            <>
              <a class="button ghost small-button" href="/feeds">
                Community
              </a>
              <span class="viewer" title={viewer.name ?? ''}>
                {viewer.avatar ? (
                  <img src={viewer.avatar} alt="" width="28" height="28" />
                ) : (
                  <span class="avatar-fallback" aria-hidden="true">
                    {initials(viewer.name ?? '')}
                  </span>
                )}
              </span>
              {viewer.preview ? (
                <span class="chip" title="Editor preview: a stand-in signed-in member">Preview</span>
              ) : (
                <button class="button link small-button" type="button" data-logout>
                  Sign out
                </button>
              )}
            </>
          ) : viewer.state === 'applicant' ? (
            <a class="button small-button" href="/join">
              Finish joining
            </a>
          ) : (
            <>
              <a class="button link" href={`/login?redirectTo=${back}`}>
                Log in
              </a>
              <a class="button" href="/join">
                Join the Community
              </a>
            </>
          )}
        </div>
      </div>
    </header>

    <div id="main" class="page-main" tabindex="-1"><slot /></div>

    <section class="closing-line" aria-label="Closing line">
      <div class="wrap">
        <p>{SHOW.closing.lead} <span>{SHOW.closing.punch}</span></p>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <div class="footer-brand">
          <strong data-brand-text="{name}">{name}</strong>
          <p>Home of {SHOW.name}. {SHOW.tagline}</p>
          <p>
            Questions for the show: <a href={`mailto:${SHOW.email}`}>{SHOW.email}</a>
          </p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          {NAV.map(item => <a href={item.href}>{item.label}</a>)}
          <a href="/join">Join the Community</a>
          <a href={`/login?redirectTo=${back}`}>Log in</a>
        </nav>
      </div>
      <div class="wrap footer-legal">
        <span data-brand-text="© {year} {name}">© {new Date().getUTCFullYear()} {name}</span>
      </div>
    </footer>

    <script>
      import {logout, refreshSession} from '../platform/browser';
      import {hydrateStaticPage} from '../platform/static-page';

      if (document.body.dataset.static === '1') void hydrateStaticPage();

      // The server saw an expired access token but a refresh cookie: refresh
      // ONCE in the browser (the server never does), then re-render signed in.
      if (document.body.dataset.viewer === 'returning') {
        const key = 'site:refreshed';
        let first = true;
        try {
          first = !sessionStorage.getItem(key);
          sessionStorage.setItem(key, '1');
        } catch {
          // Storage blocked: no way to remember the reload, so never reload
          // (it would repeat on every load). The visitor signs in again.
          first = false;
        }
        if (first) void refreshSession().then(ok => ok && window.location.reload());
      } else {
        try {
          sessionStorage.removeItem('site:refreshed');
        } catch {
          // Storage blocked: nothing to clear.
        }
      }

      // The phone menu: one button opens and closes the nav.
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        header?.toggleAttribute('data-open', open);
      });

      // Every button shows when it is busy (AGENTS.md "Buttons and forms").
      const busy = (button: HTMLButtonElement, label?: string) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        if (label) button.textContent = label;
      };

      document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach(button =>
        button.addEventListener('click', () => {
          busy(button, 'Signing out…');
          void logout();
        })
      );

      // A search / filter form (GET) navigates: show its button busy until the next page.
      document.addEventListener('submit', event => {
        const form = event.target;
        if (event.defaultPrevented || !(form instanceof HTMLFormElement)) return;
        if (form.method.toLowerCase() !== 'get') return;
        if (event.submitter instanceof HTMLButtonElement) busy(event.submitter);
      });
      // Back/forward restores a page from memory: give its buttons back.
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return;
        document.querySelectorAll<HTMLButtonElement>('button[aria-busy="true"]').forEach(button => {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        });
      });
    </script>
  </body>
</html>
