// The Site Database's schema (Prisma ORM 7). Change it, then run
// `npx prisma migrate dev --name <what-changed>` against the Preview Database
// and wrap the new migration.sql in BEGIN; … COMMIT; (see AGENTS.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The client runs in the Cloudflare Workers runtime, never in Node.
  runtime  = "workerd"
}

// The connection string is NOT here: prisma.config.ts reads DATABASE_URL from
// the environment, which the platform sets (the Build never gets one).
datasource db {
  provider = "postgresql"
}

/// The v0.1 starter's example table, no longer used by any screen. Kept because
/// dropping a table needs a migration and the owner's approval.
model Note {
  id        Int      @id @default(autoincrement())
  /// Shown as written. Never store a member's email address here.
  body      String   @db.VarChar(500)
  author    String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notes")
}

/// The starter template's job board, no longer used: its pages and routes
/// were removed. Kept because dropping a table needs a migration and the
/// owner's approval.
model Job {
  id          Int      @id @default(autoincrement())
  /// URL name, unique: `/jobs/<slug>`.
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(120)
  company     String   @db.VarChar(80)
  location    String   @db.VarChar(80)
  /// `full-time`, `part-time`, `contract` or `internship`.
  type        String   @default("full-time") @db.VarChar(20)
  remote      Boolean  @default(false)
  /// Plain text; paragraphs separated by blank lines.
  description String   @db.VarChar(10000)
  /// Where to apply: an https URL or a mailto: link the poster chose to publish.
  applyUrl    String   @map("apply_url") @db.VarChar(500)
  /// `open` (listed) or `closed` (kept, not listed).
  status      String   @default("open") @db.VarChar(10)
  /// The admin's community profile that posted it.
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, id])
  @@map("jobs")
}

/// A file a signed-in member uploaded from `/portal/uploads`. The bytes live
/// on the community's CDN (presign → PUT → register); this row keeps the
/// public URL the platform returned.
model Upload {
  id           Int      @id @default(autoincrement())
  /// The uploader's community profile (`/api/auth/me` → `profile.id`).
  profileId    Int      @map("profile_id")
  url          String   @db.VarChar(1000)
  originalName String   @map("original_name") @db.VarChar(100)
  fileType     String   @map("file_type") @db.VarChar(20)
  fileSize     Int      @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([profileId, id])
  @@map("uploads")
}

/// One episode of Real Car Talk with Mark and Hank (`/episodes`,
/// `/episodes/<slug>`). Site admins (`community:site:update`) add and edit
/// them from `/portal/episodes`.
model Episode {
  id              Int      @id @default(autoincrement())
  /// URL name, unique: `/episodes/<slug>`.
  slug            String   @unique @db.VarChar(120)
  /// The episode number shown on the site ("Ep. 12"); optional.
  number          Int?
  title           String   @db.VarChar(140)
  /// The short summary on the list (plain text).
  summary         String   @db.VarChar(600)
  /// Longer show notes on the episode page; plain text, blank line between paragraphs.
  notes           String   @default("") @db.VarChar(8000)
  /// One of the topic slugs in `src/lib/types.ts` (`TOPICS`).
  topic           String   @db.VarChar(40)
  /// The YouTube video id (the `v=` part). Null = "video coming soon".
  youtubeId       String?  @map("youtube_id") @db.VarChar(20)
  durationMinutes Int?     @map("duration_minutes")
  /// The date the episode aired; the list is newest first by this.
  publishedAt     DateTime @map("published_at")
  /// `published` (listed) or `draft` (only in the dashboard).
  status          String   @default("published") @db.VarChar(10)
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt, id])
  @@map("episodes")
}

/// A listener question sent from `/ask`. Read by site admins in
/// `/portal/questions`. Never store an email address here: listeners who
/// want a reply email askmarkandhank@gmail.com themselves.
model Question {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(80)
  /// `new-rep`, `veteran`, `bdc`, `manager` or `other`.
  role        String   @db.VarChar(20)
  dealership  String   @default("") @db.VarChar(120)
  body        String   @db.VarChar(2000)
  /// The listener agreed that their first name may be read on the show.
  okToFeature Boolean  @default(false) @map("ok_to_feature")
  /// `new`, `picked` (going on the show) or `done`.
  status      String   @default("new") @db.VarChar(10)
  /// The member's profile id when they were signed in, else null.
  profileId   Int?     @map("profile_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status, id])
  @@map("questions")
}
